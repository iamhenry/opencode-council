{
  "name": "opencode-council",
  "version": "0.1.1",
  "description": "OpenCode plugin: a multi-model council tool. Fresh child sessions deliberate in parallel; a judge returns a structured decision artifact.",
  "type": "module",
  "license": "MIT",
  "keywords": ["opencode", "opencode-plugin", "plugin", "ai", "council", "multi-model"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamhenry/opencode-council.git"
  },
  "homepage": "https://github.com/iamhenry/opencode-council#readme",
  "bugs": "https://github.com/iamhenry/opencode-council/issues",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.1.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0 <2",
    "@opencode-ai/sdk": ">=1.18.0 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.14",
    "@opencode-ai/sdk": "1.18.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
